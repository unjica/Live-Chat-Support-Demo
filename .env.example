# Copy to .env; generate with openssl rand -hex 32. Required, no default.
OPERATOR_SECRET=
# Local-only default. Change before self-hosting; use URL-safe hex characters.
POSTGRES_PASSWORD=chat-local-only
# Exact browser origin(s), comma-separated. No paths or trailing slashes.
FRONTEND_URL=http://localhost:3000
# Browser-reachable backend origin, embedded at BUILD time. Rebuild after changing.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Bind to loopback for local use / a host reverse proxy.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=3001
