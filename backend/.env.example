# Local development database only; use private credentials in hosted environments.
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat
# Generate with openssl rand -hex 32; never expose via NEXT_PUBLIC_* or commit .env.
OPERATOR_SECRET=replace-with-at-least-32-random-characters
# Exact browser origins, comma-separated. Required in production (no wildcard/path).
FRONTEND_URL=http://localhost:3000
PORT=3001

# Railway provides PORT; listen on all interfaces.
HOST=0.0.0.0

# Trusted reverse proxies in front of the backend; 0 ignores X-Forwarded-For. Railway: 1.
TRUST_PROXY_HOPS=0
